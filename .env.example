# 复制为 .env（或直接注入环境变量）后按需修改

# JWT 签名密钥（必填，生产环境请使用足够长的随机字符串）
JWT_SALT=please-change-me-to-a-long-random-string

# 签到单价（单位：分，默认 500 = 5 元）
SINGLE_PRICE=500

# 支付单有效期（分钟，默认 30）
PAY_EXPIRE_MINUTES=30

# 站内支付页公开地址（接入真实支付后用于构造回调地址，Docker/线上部署时改为实际域名）
PUBLIC_BASE_URL=http://localhost:8080

# 配置文件路径（默认 ./config.yaml）
CONFIG_PATH=config.yaml
